generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEDICO
  RECEPCIONISTA
}

enum AppointmentStatus {
  PENDIENTE
  ATENDIDO
  CANCELADO
}

enum Sex {
  MASCULINO
  FEMENINO
  OTRO
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  DESCONOCIDO
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(RECEPCIONISTA)
  specialty     String?
  cedula        String?
  clinicName    String?
  clinicAddress String?
  clinicPhone   String?
  signatureUrl  String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
  medicalNotes MedicalNote[]

  @@map("users")
}

model Patient {
  id               String    @id @default(cuid())
  fullName         String
  birthdate        DateTime
  sex              Sex
  curp             String?   @unique
  bloodType        BloodType @default(DESCONOCIDO)
  phone            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  emergencyContact String?
  emergencyPhone   String?
  insuranceName    String?
  insuranceNumber  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments       Appointment[]
  clinicalBackground ClinicalBackground?
  medicalNotes       MedicalNote[]

  @@map("patients")
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  reason    String?
  status    AppointmentStatus @default(PENDIENTE)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User    @relation(fields: [doctorId], references: [id])

  medicalNote MedicalNote?

  @@map("appointments")
}

model ClinicalBackground {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  hfDiabetes         Boolean @default(false)
  hfHypertension     Boolean @default(false)
  hfCancer           Boolean @default(false)
  hfCardiopathy      Boolean @default(false)
  hfObesity          Boolean @default(false)
  hfAsthma           Boolean @default(false)
  hfNephropathy      Boolean @default(false)
  hfPsychiatric      Boolean @default(false)
  hfOther            String?

  ppDiseases          String?
  ppSurgeries         String?
  ppHospitalizations  String?
  ppTraumas           String?
  ppTransfusions      String?

  pnpSmoking    String?
  pnpAlcohol    String?
  pnpDrugs      String?
  pnpDiet       String?
  pnpExercise   String?
  pnpHousing    String?
  pnpOccupation String?

  goMenarca   String?
  goIvsa      String?
  goGestas    Int?
  goPartos    Int?
  goAborts    Int?
  goCesareas  Int?
  goFup       String?
  goMenopause String?
  goOther     String?

  allergyMedications   String?
  allergyFood          String?
  allergyEnvironmental String?

  currentMedications String?

  @@map("clinical_backgrounds")
}

model MedicalNote {
  id               String   @id @default(cuid())
  consultationDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isLocked         Boolean  @default(false)

  reasonForVisit       String?
  bloodPressure        String?
  heartRate            Int?
  respiratoryRate      Int?
  temperature          Float?
  weight               Float?
  height               Float?
  bmi                  Float?
  oxygenSat            Float?
  physicalExam         String?
  diagnosisCode        String?
  diagnosisDescription String?
  treatmentPlan        String?
  prognosis            String?

  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User         @relation(fields: [doctorId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  prescription Prescription?

  @@map("medical_notes")
}

model Prescription {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  medications Json
  notes       String?

  noteId String      @unique
  note   MedicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}
